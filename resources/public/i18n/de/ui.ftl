diagrams_run-timing_approach = 6.9.2: Phase „Ice nähern“

diagrams_run-timing_approach-a = Du näherst dich nun dem Ice. „Nähern“-Ereignisse werden abgehandelt

diagrams_run-timing_approach-b = Fenster für bezahlte Fähigkeiten. Der Konzern darf in diesem Fenster das Ice, dem sich genähert wird, oder Karten, die kein Ice sind, laden

diagrams_run-timing_approach-c = Ist das Ice, dem sich genähert wird, geladen, weiter zur Begegnungsphase (6.9.3)

diagrams_run-timing_approach-d = Andernfalls weiter zur Bewegungsphase (6.9.4)

diagrams_run-timing_disclaimer = Diese Struktur wurde zur besseren Übersicht vereinfacht. Die vollständigen Regeln findest du auf der Website von Null Signal Games.

diagrams_run-timing_encounter = 6.9.3: Phase „Auf Ice treffen“

diagrams_run-timing_encounter-a = Du triffst nun auf dieses Ice. „Treffen“-Ereignisse werden abgehandelt

diagrams_run-timing_encounter-b = Fenster für bezahlte Fähigkeiten. In diesem Fenster können Fähigkeiten gegen das Ice eingesetzt werden, auf das du triffst

diagrams_run-timing_encounter-c = Gibt es nicht ausgeschaltete Subroutinen abzuhandeln, handelt der Konzern die oberste nicht ausgeschaltete Subroutine ab. Falls ja, wiederhole diesen Schritt

diagrams_run-timing_encounter-d = Die Begegnung ist abgeschlossen. Weiter zur Bewegungsphase (6.9.4)

diagrams_run-timing_header = Zeitlicher Ablauf eines Runs

diagrams_run-timing_initiation = 6.9.1: Startphase

diagrams_run-timing_initiation-a = Der Runner bestimmt ein System

diagrams_run-timing_initiation-b = Der Runner erhält Credits für negative Publicity

diagrams_run-timing_initiation-c = Der Run beginnt offiziell – Run-Ereignisse werden ausgelöst

diagrams_run-timing_initiation-c-2 = Fenster für bezahlte Fähigkeiten. Der Konzern darf in diesem Fenster Karten laden, die kein Ice sind.

diagrams_run-timing_initiation-d = Weiter zum äußersten Ice, falls vorhanden, und Beginn der Phase „Ice nähern“ (6.9.2)

diagrams_run-timing_initiation-e = Andernfalls weiter zur Bewegungsphase (6.9.4)

diagrams_run-timing_movement = 6.9.4: Bewegungsphase

diagrams_run-timing_movement-a = Hast du dich einem Ice genähert oder bist darauf getroffen, passierst du es. „Passieren“-Ereignisse werden abgehandelt

diagrams_run-timing_movement-b = Gibt es innerhalb des passierten Ice kein weiteres Ice, werden Ereignisse „wenn du alles Ice des Systems passierst“ abgehandelt

diagrams_run-timing_movement-c = Fenster für bezahlte Fähigkeiten

diagrams_run-timing_movement-d = Der Runner darf sich ausstöpseln. Falls er das tut, weiter zur Phase „Run endet“ (6.9.6)

diagrams_run-timing_movement-e = Der Runner bewegt sich zur nächsten inneren Position, falls vorhanden

diagrams_run-timing_movement-f = Fenster für bezahlte Fähigkeiten. Der Konzern darf Karten laden, die kein Ice sind

diagrams_run-timing_movement-g = Näherst du dich einem weiteren Ice, zurück zur Phase „Ice nähern“ (6.9.2)

diagrams_run-timing_movement-h = Der Runner nähert sich dem angegriffenen System. „Nähern“-Ereignisse werden abgehandelt

diagrams_run-timing_movement-i = Weiter zur Erfolgsphase (6.9.5)

diagrams_run-timing_run-ends = 6.9.6: Phase „Run endet“

diagrams_run-timing_run-ends-a = Alle offenen Prioritätsfenster werden abgeschlossen oder geschlossen

diagrams_run-timing_run-ends-b = Der Runner verliert alle nicht ausgegebenen Credits für negative Publicity

diagrams_run-timing_run-ends-c = Wurde die Erfolgsphase nicht erreicht und existiert das System noch, ist der Run erfolglos

diagrams_run-timing_run-ends-d = Der Run endet. „Run endet“-Ereignisse werden abgehandelt

diagrams_run-timing_success = 6.9.5: Erfolgsphase

diagrams_run-timing_success-a = Der Run wird für erfolgreich erklärt. Ereignisse für erfolgreiche Runs werden ausgelöst

diagrams_run-timing_success-b = Der Runner dringt in das angegriffene System ein

diagrams_run-timing_success-c = Die Erfolgsphase ist abgeschlossen. Weiter zur Phase „Run endet“ (6.9.6)

diagrams_turn_corp-action-phase = 5.6.2: Aktionsphase

diagrams_turn_corp-action-phase-a = Fenster für bezahlte Fähigkeiten. Der Konzern darf in diesem Fenster Karten laden, die kein Ice sind, oder Punkte für Agenden erzielen

diagrams_turn_corp-action-phase-b = Hat der Konzern nicht ausgegebene [Clicks], führt er eine Aktion durch

diagrams_turn_corp-action-phase-c = Wurde eine Aktion durchgeführt, zurück zu (a)

diagrams_turn_corp-action-phase-d = Die Aktionsphase ist abgeschlossen. Weiter zur Abwurfphase (5.6.3)

diagrams_turn_corp-discard-phase = 5.6.3: Abwurfphase

diagrams_turn_corp-discard-phase-a = Der Konzern legt, falls nötig, Karten bis zum Handkartenlimit ab

diagrams_turn_corp-discard-phase-b = Fenster für bezahlte Fähigkeiten. Der Konzern darf in diesem Fenster Karten laden, die kein Ice sind

diagrams_turn_corp-discard-phase-c = Hat der Konzern noch [Clicks] übrig, verliert er diese [Clicks]

diagrams_turn_corp-discard-phase-d = Der Zug des Konzerns endet offiziell. Auslöser für das Zugende werden abgehandelt

diagrams_turn_corp-discard-phase-e = Weiter zum Zug des Runners

diagrams_turn_corp-draw-phase = 5.6.1: Ziehphase

diagrams_turn_corp-draw-phase-a = Der Konzern erhält die zur Verfügung stehenden Klicks (Standard: [click][click][click])

diagrams_turn_corp-draw-phase-b = Fenster für bezahlte Fähigkeiten. Der Konzern darf in diesem Fenster Karten laden, die kein Ice sind, oder Punkte für Agenden erzielen

diagrams_turn_corp-draw-phase-c = Wiederkehrende Credits des Konzerns werden aufgefüllt

diagrams_turn_corp-draw-phase-d = Der Zug beginnt offiziell. „Zugbeginn“-Ereignisse werden abgehandelt

diagrams_turn_corp-draw-phase-e = Der Konzern zieht seine verpflichtende Karte

diagrams_turn_corp-draw-phase-f = Weiter zur Aktionsphase (5.6.2)

diagrams_turn_corp-turn = Zug des Konzerns

